# ─────────────────────────────────────────────────────────────────────────────
# VideoNoteExtractor — environment variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
# Your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# ── OpenAI model (optional, defaults to gpt-4o-mini) ─────────────────────────
# Any chat-completion model you have access to.
# Examples: gpt-4o, gpt-4o-mini, gpt-4-turbo
OPENAI_MODEL=gpt-4o-mini

# ── Budget / cost tracking (optional) ────────────────────────────────────────
# Stop the summarize step when the estimated cost reaches this USD amount.
# Leave at 0 to disable budget enforcement.
OPENAI_MAX_COST_USD=0

# Token prices for your chosen model (per 1 million tokens).
# Find current prices at https://openai.com/pricing
# Example values below are for gpt-4o-mini as of 2025.
OPENAI_INPUT_COST_PER_MILLION=0.15
OPENAI_OUTPUT_COST_PER_MILLION=0.60

# ── Rate-limiting (optional) ──────────────────────────────────────────────────
# Base delay (seconds) between API calls in the summarize step.
DELAY_BASE_SECONDS=2.0
# Every this many chunks, add DELAY_ADD_SECONDS to the base delay.
DELAY_ADD_PER_CHUNKS=4
# Extra seconds added per DELAY_ADD_PER_CHUNKS chunks.
DELAY_ADD_SECONDS=1.0

# ── Parallel summarization (optional) ────────────────────────────────────────
# Number of parallel workers for the summarize step.
# 1 = sequential (default, preserves anti-repetition context).
# >1 = parallel (faster, but anti-repetition is disabled).
SUMMARIZE_WORKERS=1

# ── Slide / visual mode (optional) ───────────────────────────────────────────
# Sensitivity for scene-change detection (0.0–1.0). Lower = more frames.
SLIDE_SCENE_THRESHOLD=0.35

# Maximum number of slide frames to extract (leave blank for no limit).
SLIDE_MAX_FRAMES=

# Path to the Tesseract executable (only needed if tesseract is not on PATH).
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Tesseract language code for OCR. Leave blank to auto-detect (usually 'eng').
# Multi-language example: eng+ara
OCR_LANG=

# Override the default slide OCR index path used by summarize_chunks.py.
SLIDES_INDEX_PATH=slides/index.json

# ── Reduce step (optional) ────────────────────────────────────────────────────
# Max characters per batch sent to GPT during the reduce (consolidation) step.
REDUCE_BATCH_CHARS=12000
