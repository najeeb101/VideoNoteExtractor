# ─────────────────────────────────────────────────────────────────────────────
# Lectura / VideoNoteExtractor — backend environment variables
# Copy this file to .env (repo root) and fill in your values.
#
# The frontend has its OWN env — see frontend/.env.local (NEXT_PUBLIC_* vars),
# documented at the bottom of this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM keys — you need AT LEAST ONE ─────────────────────────────────────────
# The pipeline (summarize/reduce/extract) prefers OpenAI, but falls back to Groq
# automatically when OPENAI_API_KEY is absent. The chat endpoint always uses Groq.
# Simplest setup: just set GROQ_API_KEY and skip OpenAI entirely.

# Groq (OpenAI-compatible) — powers the chat endpoint and, by default, the pipeline.
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI — optional. If set, the pipeline uses it instead of Groq.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=            # advanced: point the OpenAI SDK at any compatible endpoint

# ── Supabase (auth + persistence) — REQUIRED for the web app ─────────────────
# Server-side service-role key. Keep this secret; never expose to the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...

# CORS: the frontend origin the backend should allow (besides localhost:3000).
FRONTEND_URL=http://localhost:3000

# ── Pipeline tuning (optional) ────────────────────────────────────────────────
# Stop the summarize step when estimated cost reaches this USD amount (0 = off).
OPENAI_MAX_COST_USD=0
# Per-1M-token prices for cost tracking (see https://openai.com/pricing).
OPENAI_INPUT_COST_PER_MILLION=0.15
OPENAI_OUTPUT_COST_PER_MILLION=0.60

# Rate-limiting between summarize API calls.
DELAY_BASE_SECONDS=2.0
DELAY_ADD_PER_CHUNKS=4
DELAY_ADD_SECONDS=1.0

# Parallel summarization: 1 = sequential (anti-repetition on), >1 = parallel.
SUMMARIZE_WORKERS=1

# Max characters per batch during the reduce (consolidation) step.
REDUCE_BATCH_CHARS=12000

# ── Transcription (optional) ──────────────────────────────────────────────────
# Force the faster-whisper device: "cpu" or "cuda". Leave blank to auto-detect
# (auto falls back to CPU if CUDA libraries fail to load at runtime).
WHISPER_DEVICE=

# ── Visual / slide mode (optional; web runs with --no-visual) ─────────────────
SLIDE_SCENE_THRESHOLD=0.35
SLIDE_MAX_FRAMES=
TESSERACT_CMD=
OCR_LANG=
SLIDES_INDEX_PATH=slides/index.json

# ─────────────────────────────────────────────────────────────────────────────
# Frontend env (put these in frontend/.env.local, NOT here):
#   NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...        # anon/publishable key
#   NEXT_PUBLIC_API_URL=http://127.0.0.1:8000   # backend base URL (optional)
# ─────────────────────────────────────────────────────────────────────────────
