# Never upload your API keys!
.env

# Python byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# Transcripts and audio files (they get large, no need to upload them to GitHub)
audio.mp3
audio.webm
transcript*.txt

# Pipeline-generated notes (regenerated per run) — ignore by name so docs like
# README.md and CLAUDE.md stay tracked.
chunk_notes.md
notes_reduced.md
notes.md
